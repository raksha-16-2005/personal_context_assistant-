# Copy to webapp/.env (gitignored). Loaded the same way ../.env is - see
# emailrag.llm.client.load_dotenv, reused here rather than re-invented.

# Same Postgres instance the ablation/pgvector work already uses (see
# ../config.yaml), a different set of tables.
DATABASE_URL=postgresql:///emailrag

# A Fernet key, e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This is the master key for envelope-encrypting oauth_tokens and gemini_keys.
# Never commit it, never log it. Losing it makes every stored token/key
# permanently undecryptable - back it up in the hosting platform's secret
# manager, not in this file.
MASTER_KEY=

# Signs session cookies. Same rotation caution as MASTER_KEY, lower stakes -
# rotating this just logs everyone out.
SESSION_SECRET=

# From Google Cloud Console -> Credentials -> OAuth client ID -> Web application.
# Phase 0 of the plan: this is a *different* client type than the existing
# Desktop-app credential scripts/gmail_auth.py uses locally.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Must exactly match a redirect URI registered on that Web application client.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Only set these two if the frontend is deployed separately from this backend
# (e.g. this backend on Fly, the built React app on Vercel) - see DEPLOY.md's
# "Splitting the frontend onto Vercel" section. Leave unset for a same-origin
# deployment (this backend serving its own webapp/frontend/dist).
#
# The frontend's own public URL - used for CORS and for where to redirect
# after login/logout. Defaults to OAUTH_REDIRECT_BASE_URL.
# FRONTEND_BASE_URL=https://your-app.vercel.app
#
# "none" is required for the session cookie to survive a cross-site fetch
# once frontend and backend are on different domains (browsers refuse to
# send a "lax" cookie on a cross-site request). Requires HTTPS.
# SESSION_COOKIE_SAMESITE=none

# data/index/users/<user_id>/ lives here - a persistent volume in production,
# not inside the repo. See scripts/check_privacy.py's GMAIL_ARTIFACTS list for
# why this must never be a path under the repo root.
USER_INDEX_ROOT=/var/lib/emailrag/users

# The shipped ablation config every user's mailbox is indexed with. Picked
# once from the README's dimension 1-3 results, not re-decided per user.
SHIPPED_CHUNKING=thread_aware
SHIPPED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SHIPPED_RERANK=L2@20/t192

# Runs the ingestion job queue (syncs, extraction, digests) as a background
# thread inside this same process - see app/jobs/runner.py. Set to "false"
# only to run it as its own separate process instead (python -m
# app.jobs.runner), e.g. to isolate it on its own machine.
# RUN_WORKER_IN_PROCESS=true
