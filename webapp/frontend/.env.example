# Copy to webapp/frontend/.env.local (gitignored) for local dev, or set as a
# Vercel project environment variable for a real deploy.
#
# Only needed when this frontend is deployed separately from the FastAPI
# backend (e.g. this app on Vercel, the backend on Fly) - see DEPLOY.md's
# "Splitting the frontend onto Vercel" section. Leave unset for local dev,
# which proxies relative paths to localhost:8000 instead (vite.config.js).
VITE_API_BASE_URL=https://your-app.fly.dev
